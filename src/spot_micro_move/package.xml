<?xml version="1.0"?>
<package format="3">
  <name>spot_micro_move</name>
  <version>0.1.0</version>
  <description>Trot gait node driving the real PCA9685 servos via spot_micro_ik, commanded by the Steam Deck's Joy input</description>
  <maintainer email="layillatoo@gmail.com">SpotMicro</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Only for the AXIS_NAMES/BUTTON_NAMES index constants in protocol.py -->
  <exec_depend>spot_micro_deck</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
