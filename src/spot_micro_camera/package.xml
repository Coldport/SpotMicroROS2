<?xml version="1.0"?>
<package format="3">
  <name>spot_micro_camera</name>
  <version>0.1.0</version>
  <description>Camera launch/config for SpotMicro: detects whether the Intel RealSense D405 or a plain USB webcam is plugged in and starts realsense2_camera or usb_cam to match</description>
  <maintainer email="layillatoo@gmail.com">SpotMicro</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
