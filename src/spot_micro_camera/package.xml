<?xml version="1.0"?>
<package format="3">
  <name>spot_micro_camera</name>
  <version>0.1.0</version>
  <description>Intel RealSense D405 driver launch/config for SpotMicro, publishing color and depth images over ROS2</description>
  <maintainer email="layillatoo@gmail.com">SpotMicro</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
